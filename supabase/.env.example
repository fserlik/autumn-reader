# BACKEND ONLY. Copy to supabase/.env (ignored). Never prefix secrets with VITE_.
# Cloud runtime injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
DEEPL_AUTH_KEY=
# developer (initial free credit), or legacy-free for an existing API Free account.
DEEPL_API_PLAN=developer

# Amazon Polly Neural. Use an IAM user/role limited to polly:SynthesizeSpeech.
# us-east-1 is the conservative default; unsupported Neural regions fail during preflight.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Server-enforced controls. No client release is needed to change these values.
AI_SPEECH_MONTHLY_BUDGET_USD=10
AI_SPEECH_RETENTION_DAYS=90
POLLY_NEURAL_USD_PER_MILLION_CHARS=16

# Lemon Squeezy billing (server-side only).
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=491763
LEMONSQUEEZY_PLUS_MONTHLY_VARIANT_ID=2216029
LEMONSQUEEZY_PLUS_ANNUAL_VARIANT_ID=2216031
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=2216032
LEMONSQUEEZY_PRO_ANNUAL_VARIANT_ID=2216034

ALLOWED_ORIGINS=http://127.0.0.1:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
