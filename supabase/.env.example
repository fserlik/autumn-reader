# BACKEND ONLY. Copy to supabase/.env (ignored). Never prefix secrets with VITE_.
# Cloud runtime injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
DEEPL_AUTH_KEY=
# Autumn Reader is configured for the no-charge API Developer allowance.
DEEPL_API_PLAN=developer-free
DEEPL_API_ENDPOINT=https://api-free.deepl.com
DEEPL_GLOBAL_MONTHLY_CHARACTER_LIMIT=250000
DEEPL_MONTHLY_BUDGET_USD=0
DEEPL_LIFETIME_CHARACTER_LIMIT=1000000
# Required before enabling DeepL: copy the already-used lifetime character
# count from the provider panel. Leave blank to fail closed.
DEEPL_LIFETIME_USED_BASELINE=

# Amazon Polly Neural. Use an IAM user/role limited to polly:SynthesizeSpeech.
# us-east-1 is the conservative default; unsupported Neural regions fail during preflight.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Server-enforced controls. No client release is needed to change these values.
AI_SPEECH_MONTHLY_BUDGET_USD=10
AI_SPEECH_RETENTION_DAYS=90
POLLY_NEURAL_USD_PER_MILLION_CHARS=16

# Lemon Squeezy billing (server-side only). Configure one complete set per
# Supabase environment: Test Mode for local/staging, Live Mode for production.
# Do not reuse Test Mode IDs in Live Mode.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Reused from the existing Autumn Reader configuration; verify it against
# both confirmed variants in the selected Test/Live mode before deployment.
LEMONSQUEEZY_STORE_ID=491763
LEMONSQUEEZY_MODE=test
LEMONSQUEEZY_PREMIUM_MONTHLY_VARIANT_ID=2236412
LEMONSQUEEZY_PREMIUM_LIFETIME_VARIANT_ID=2236414

# Protects the internal, dry-run-only orphan collector endpoint.
R2_ORPHAN_COLLECTOR_SECRET=

ALLOWED_ORIGINS=http://127.0.0.1:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
