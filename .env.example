# FRONTEND: public values only. Copy to .env; never commit credentials.
VITE_SUPABASE_URL=
# Use one public key: publishable is preferred; anon is the legacy alternative.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
# Public R2 account ID for generation of the exact CSP hosts, not an access key.
VITE_R2_ACCOUNT_ID=
# Backend secrets belong in supabase/.env or Supabase Secrets; see supabase/.env.example.
# Never place Lemon Squeezy API keys, webhook secrets, or the Supabase service-role key here.
